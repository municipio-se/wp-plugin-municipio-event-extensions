msgid "Enter a valid date."
msgstr "Ange ett giltigt datum."

msgid "The end date must not precede the start date."
msgstr "Till-datum får inte vara före från-datum."

msgid "Enter an age between 0 and 99."
msgstr "Ange en ålder mellan 0 och 99."

msgid "The maximum age must not be lower than the minimum age."
msgstr "Till-ålder får inte vara lägre än från-ålder."

